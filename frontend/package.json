{
  "name": "template-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "i18n:key": "bun scripts/i18n-key.ts",
    "paraglide": "paraglide-js compile --project ./project.inlang",
    "paraglide:translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@inlang/cli": "^3.3.4",
    "@inlang/paraglide-js": "^2.25.0",
    "@inlang/plugin-m-function-matcher": "^2.2.13",
    "@inlang/plugin-message-format": "^4.4.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-react": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "human-id": "^4.2.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2"
  }
